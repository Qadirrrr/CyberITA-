# CyberITA+ Lab Agent — environment template
# Copy this file to server/.env on the LAB SERVER (not the Main Server)
# and fill in the values. Keep secrets out of git.

# ----- Agent identity -----
NODE_ENV=production
AGENT_NAME=lab-server-1
AGENT_PORT=9100
AGENT_URL=http://172.31.14.28:9100
AGENT_SECRET=12341234
AGENT_MAX_SESSIONS=15

# ----- Main Server (private IP) -----
MAIN_SERVER_URL=http://172.31.4.87:4000

# ----- Docker lab runtime (same as Main Server) -----
LAB_PROVIDER=docker
LAB_DOCKER_IMAGE=cyberita/lab-runtime:1.0
LAB_DOCKER_NETWORK=true
LAB_DOCKER_PULL=true
LAB_DOCKER_MEMORY_MB=1024
LAB_DOCKER_CPUS=1
LAB_DOCKER_PIDS_LIMIT=256
LAB_DOCKER_TIMEOUT_MS=180000
LAB_DOCKER_PROVISION_TIMEOUT_MS=180000
LAB_DOCKER_MAX_OUTPUT_BYTES=65536

# ----- Optional -----
# LAB_DOCKER_BINARY=docker
# LAB_DOCKER_HOST=
# LAB_AGENT_MASTER_KEY=   (not needed on agent; only on Main Server)
