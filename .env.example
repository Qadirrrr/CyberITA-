PORT=4000
NODE_ENV=development

# ----- PostgreSQL -----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgresql
DB_NAME=CyberITA
DB_SSL=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=7d

CORS_ORIGINS=http://localhost:5173

# Use "docker" for real Linux containers. "mock" is test-only and executes no real commands.
LAB_PROVIDER=docker
LAB_SESSION_TTL_MINUTES=120
LAB_CLEANUP_INTERVAL_MINUTES=5

# Docker lab runtime. LAB_DOCKER_HOST supports Docker CLI contexts such as
# ssh://labuser@lab-host. Leave blank to use the local Docker socket.
LAB_DOCKER_HOST=
# LAB_DOCKER_BINARY=docker
LAB_DOCKER_IMAGE=cyberita/lab-runtime:1.0
LAB_DOCKER_NETWORK=true
LAB_DOCKER_PULL=true
LAB_DOCKER_MEMORY_MB=1024
LAB_DOCKER_CPUS=1
LAB_DOCKER_PIDS_LIMIT=256
LAB_DOCKER_TIMEOUT_MS=180000
LAB_DOCKER_PROVISION_TIMEOUT_MS=180000
LAB_DOCKER_MAX_OUTPUT_BYTES=65536

MAX_UPLOAD_MB=8
