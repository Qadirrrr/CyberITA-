PORT=4000
NODE_ENV=development

# ----- PostgreSQL -----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgresql
DB_NAME=CyberITA
DB_SSL=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=7d

CORS_ORIGINS=http://localhost:5173

# ----- Email (verification + password reset) -----
# Email verification is REQUIRED before a user can sign in.
# Without SMTP: emails are stored in email_outbox table and the link is
# printed in the server log and echoed in the API response (dev only).
#
# To use Gmail SMTP:
#   1. Enable 2-Step Verification on your Google Account
#   2. Go to: Google Account -> Security -> 2-Step Verification -> App Passwords
#   3. Create an App Password (select Mail + your device)
#   4. Copy the 16-character password and paste it as SMTP_PASS below
APP_URL=http://localhost:5173
# Public origin of the site (scheme://host:port, no trailing slash). Used for
# emailed verification/reset links when there is no incoming request (for
# example background jobs). Auth emails triggered by a request use the origin
# the learner is actually browsing, so a stale value here cannot break them.
# Examples: https://cyberita.example.com  |  http://203.0.113.10:4000
MAIL_FROM="CyberITA+ <no-reply@cyberita.plus>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# Lab provider: "docker" (production). The simulator exists only in the test suite.
LAB_PROVIDER=docker
LAB_SESSION_TTL_MINUTES=120
LAB_CLEANUP_INTERVAL_MINUTES=5

# Docker lab runtime. LAB_DOCKER_HOST supports Docker CLI contexts such as
# ssh://labuser@lab-host. Leave blank to use the local Docker socket.
LAB_DOCKER_HOST=
# The API process looks `docker` up on PATH and then in common install
# locations (/usr/bin, /usr/local/bin, /snap/bin, Docker Desktop, ...).
# Set this only if the CLI lives somewhere unusual or is not executable
# by the service account, e.g. /usr/bin/docker or C:\...\docker.exe.
# LAB_DOCKER_BINARY=docker
LAB_DOCKER_IMAGE=cyberita/lab-runtime:1.0
LAB_DOCKER_NETWORK=true
LAB_DOCKER_PULL=true
LAB_DOCKER_MEMORY_MB=1024
LAB_DOCKER_CPUS=1
LAB_DOCKER_PIDS_LIMIT=256
LAB_DOCKER_TIMEOUT_MS=180000
LAB_DOCKER_PROVISION_TIMEOUT_MS=180000
LAB_DOCKER_MAX_OUTPUT_BYTES=65536

MAX_UPLOAD_MB=8
