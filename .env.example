PORT=4000
NODE_ENV=development

# ----- PostgreSQL -----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgresql
DB_NAME=CyberITA
DB_SSL=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=7d

CORS_ORIGINS=http://localhost:5173

# ----- Email (verification + password reset) -----
# Without SMTP configured every email is written to the email_outbox table and
# printed to the server log, and the API echoes the link in non-production.
# With SMTP set, emails are delivered for real and links are never echoed.
APP_URL=http://localhost:5173
MAIL_FROM="CyberITA+ <no-reply@cyberita.plus>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# Lab provider: "docker" (production). The simulator exists only in the test suite.
LAB_PROVIDER=docker
LAB_SESSION_TTL_MINUTES=120
LAB_CLEANUP_INTERVAL_MINUTES=5

# Docker lab runtime. LAB_DOCKER_HOST supports Docker CLI contexts such as
# ssh://labuser@lab-host. Leave blank to use the local Docker socket.
LAB_DOCKER_HOST=
# LAB_DOCKER_BINARY=docker
LAB_DOCKER_IMAGE=cyberita/lab-runtime:1.0
LAB_DOCKER_NETWORK=true
LAB_DOCKER_PULL=true
LAB_DOCKER_MEMORY_MB=1024
LAB_DOCKER_CPUS=1
LAB_DOCKER_PIDS_LIMIT=256
LAB_DOCKER_TIMEOUT_MS=180000
LAB_DOCKER_PROVISION_TIMEOUT_MS=180000
LAB_DOCKER_MAX_OUTPUT_BYTES=65536

MAX_UPLOAD_MB=8
